# Browser-accessible API. Use the same site as the frontend in production,
# e.g. app.validatecall.com and api.validatecall.com, both HTTPS.
VITE_API_URL=http://localhost:3002

# Optional analytics (both values required)
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Existing pricing page mode
VITE_STRIPE_MODE=test
